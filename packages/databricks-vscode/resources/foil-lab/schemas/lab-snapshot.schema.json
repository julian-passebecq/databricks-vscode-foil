{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://foil.local/schemas/lab-snapshot.schema.json",
    "title": "FOIL Lab Campaign Snapshot",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "schemaVersion",
        "snapshotId",
        "generatedAt",
        "source",
        "machine",
        "model",
        "study",
        "campaign"
    ],
    "properties": {
        "schema": {
            "const": "foil-lab/campaign-snapshot-v1"
        },
        "schemaVersion": {
            "const": 1
        },
        "snapshotId": {
            "type": "string",
            "minLength": 1
        },
        "generatedAt": {
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["database", "studyId", "campaignId"],
            "properties": {
                "database": {
                    "const": "foil_lab"
                },
                "studyId": {
                    "type": "string",
                    "minLength": 1
                },
                "campaignId": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "machine": {
            "type": "object",
            "additionalProperties": true,
            "required": ["machineId", "revision", "technology", "status"],
            "properties": {
                "machineId": {
                    "type": "string",
                    "minLength": 1
                },
                "revision": {
                    "type": "string",
                    "minLength": 1
                },
                "technology": {
                    "enum": ["EOLIEN", "HYDROLIEN", "PROPULSION"]
                },
                "status": {
                    "enum": ["ACTIVE", "REFERENCE_ONLY", "EXPERIMENTAL"]
                },
                "facts": {
                    "type": "array"
                },
                "parameters": {
                    "type": "array"
                },
                "unknowns": {
                    "type": "array"
                }
            }
        },
        "model": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "modelId",
                "version",
                "status",
                "classification",
                "maturityLevel"
            ],
            "properties": {
                "modelId": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "type": "string",
                    "minLength": 1
                },
                "classification": {
                    "enum": ["SYNTHETIC", "SANITIZED_APPROVED"]
                },
                "maturityLevel": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "study": {
            "type": "object",
            "additionalProperties": true,
            "required": ["studyId", "title", "objective"],
            "properties": {
                "studyId": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "objective": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "campaign": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "campaignId",
                "objective",
                "classification",
                "inputs",
                "analyses"
            ],
            "properties": {
                "campaignId": {
                    "type": "string",
                    "minLength": 1
                },
                "objective": {
                    "type": "string",
                    "minLength": 1
                },
                "classification": {
                    "enum": ["SYNTHETIC", "SANITIZED_APPROVED"]
                },
                "inputs": {
                    "type": "object"
                },
                "analyses": {
                    "type": "array",
                    "minItems": 1
                },
                "outputs": {
                    "type": "object"
                }
            }
        }
    }
}
