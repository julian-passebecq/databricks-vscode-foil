{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://foil.local/schemas/app.schema.json",
    "title": "FOIL Virtual Lab App",
    "type": "object",
    "required": [
        "version",
        "appId",
        "appName",
        "framework",
        "deployment",
        "catalog",
        "goldSchema",
        "sqlWarehouseId",
        "readOnly",
        "canLaunchCampaigns",
        "pages"
    ],
    "properties": {
        "version": {
            "type": "string",
            "minLength": 1
        },
        "appId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "appName": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "framework": {
            "const": "STREAMLIT"
        },
        "deployment": {
            "enum": [
                "DATABRICKS_APP",
                "EXTERNAL"
            ]
        },
        "catalog": {
            "type": "string"
        },
        "goldSchema": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sqlWarehouseId": {
            "type": "string"
        },
        "readOnly": {
            "type": "boolean"
        },
        "canLaunchCampaigns": {
            "type": "boolean"
        },
        "pages": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        }
    },
    "additionalProperties": true
}
