{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://foil.local/schemas/project.schema.json",
    "title": "FOIL Virtual Lab Project",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "name",
        "activeTechnology",
        "defaultClassification",
        "allowRealData",
        "databricks"
    ],
    "properties": {
        "version": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "activeTechnology": {
            "enum": [
                "EOLIEN",
                "HYDROLIEN",
                "PROPULSION"
            ]
        },
        "defaultClassification": {
            "enum": [
                "SYNTHETIC",
                "SANITIZED_APPROVED"
            ]
        },
        "allowRealData": {
            "const": false,
            "description": "Free/Demo lab remains synthetic or explicitly sanitized only."
        },
        "databricks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "target",
                "goldSchema",
                "labJob",
                "appResource"
            ],
            "properties": {
                "target": {
                    "type": "string",
                    "minLength": 1
                },
                "goldSchema": {
                    "type": "string",
                    "minLength": 1
                },
                "labJob": {
                    "type": "string",
                    "minLength": 1
                },
                "appResource": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
