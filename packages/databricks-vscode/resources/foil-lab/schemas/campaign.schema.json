{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://foil.local/schemas/campaign.schema.json",
    "title": "FOIL Experiment Campaign",
    "type": "object",
    "required": [
        "campaignId",
        "technology",
        "machineId",
        "classification",
        "objective",
        "analyses"
    ],
    "properties": {
        "campaignId": {
            "type": "string",
            "minLength": 1
        },
        "technology": {
            "enum": [
                "EOLIEN",
                "HYDROLIEN",
                "PROPULSION"
            ]
        },
        "machineId": {
            "type": "string",
            "minLength": 1
        },
        "classification": {
            "enum": [
                "SYNTHETIC",
                "SANITIZED_APPROVED"
            ]
        },
        "objective": {
            "type": "string",
            "minLength": 1
        },
        "test": {
            "type": "object",
            "description": "Version-controlled machine/environment/control test inputs."
        },
        "analyses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "module"
                ],
                "properties": {
                    "module": {
                        "type": "string",
                        "minLength": 1
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "config": {
                        "type": "object"
                    }
                },
                "additionalProperties": true
            }
        },
        "outputs": {
            "type": "object",
            "properties": {
                "gold": {
                    "type": "boolean"
                },
                "aiBiDashboard": {
                    "type": "boolean"
                },
                "streamlitApp": {
                    "type": "boolean"
                },
                "mlflow": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": true
}
