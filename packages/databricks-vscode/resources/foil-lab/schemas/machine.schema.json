{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://foil.local/schemas/machine.schema.json",
    "title": "FOIL Machine Profile",
    "type": "object",
    "required": [
        "machineId",
        "technology",
        "status",
        "classification",
        "modelVersion"
    ],
    "properties": {
        "machineId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "technology": {
            "enum": [
                "EOLIEN",
                "HYDROLIEN",
                "PROPULSION"
            ]
        },
        "status": {
            "enum": [
                "ACTIVE",
                "REFERENCE_ONLY",
                "EXPERIMENTAL"
            ]
        },
        "classification": {
            "enum": [
                "SYNTHETIC",
                "SANITIZED_APPROVED"
            ]
        },
        "modelVersion": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        },
        "parameters": {
            "type": "object"
        }
    },
    "additionalProperties": true
}
